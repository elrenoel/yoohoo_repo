# ==============================================================================
# Yoohoo (AI Flashcard & Quiz App) — Environment Variables Template
# ==============================================================================
# Petunjuk:
# 1. Untuk local development, salin file ini menjadi .env.local dan isi nilainya.
# 2. Untuk deployment di Vercel, tambahkan variabel-variabel di bawah ini ke
#    Dashboard Vercel: Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (server-only — jangan gunakan prefix NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Project URL: Supabase Dashboard -> Project Settings -> Data API
SUPABASE_URL="https://your-project.supabase.co"

# Secret/service_role key: Supabase Dashboard -> Project Settings -> API Keys
# WAJIB hanya tersedia di server. Jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY="your_server_only_service_role_key"

# PostgreSQL connection string untuk Better Auth dan raw SQL (postgres.js).
# Gunakan Session Pooler jika jaringan lokal tidak mendukung IPv6 direct connection.
SUPABASE_DATABASE_URL="postgresql://postgres.project:password@pooler.supabase.com:6543/postgres?sslmode=require"

# Project ref, misalnya abcdefghijklmnopqrst. Digunakan oleh Supabase CLI.
SUPABASE_PROJECT_ID="your-project-ref"

# Opsional: CA certificate dari Supabase Database Settings.
# Simpan sebagai satu baris dengan newline ditulis sebagai \n.
SUPABASE_DATABASE_CA=""

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API
# ------------------------------------------------------------------------------
# Dapatkan API key dari Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key"

# Model Gemini yang digunakan (Default: gemini-3.5-flash-lite)
# Pilihan lain: gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 3. Better Auth Configuration
# ------------------------------------------------------------------------------
# Secret acak minimal 32 karakter untuk enkripsi session & JWT.
# Cara generate: jalankan `openssl rand -base64 32` di terminal
BETTER_AUTH_SECRET="your_random_32_character_secret_key_here"

# Base URL aplikasi:
# - Lokal: http://localhost:3000
# - Vercel: https://your-project-name.vercel.app (tanpa trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials (opsional, untuk login dengan Google)
# ------------------------------------------------------------------------------
# Buat OAuth Client ID di Google Cloud Console (https://console.cloud.google.com)
#
# Authorized JavaScript origins:
# - Lokal: http://localhost:3000
# - Production: https://your-project-name.vercel.app
#
# Authorized redirect URIs:
# - Lokal: http://localhost:3000/api/auth/callback/google
# - Production: https://your-project-name.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. AWS RAG pipeline (server-only)
# ------------------------------------------------------------------------------
# AWS SDK memakai default credential chain. Di deployment gunakan IAM role;
# untuk lokal, AWS_PROFILE boleh menunjuk profile dari AWS CLI.
AWS_PROFILE=""
AWS_REGION="ap-southeast-2"
RAG_BUCKET_NAME="yoohoo-rag-dev-pdf"

# Didapat dari output CloudFormation setelah stack RAG berhasil di-deploy.
RAG_STATE_MACHINE_ARN="arn:aws:states:ap-southeast-2:123456789012:stateMachine:yoohoo-rag-dev"

# Jumlah halaman PDF per chunk. Default aplikasi: 5.
RAG_CHUNK_PAGES="5"

# Paragraf terakhir yang dibawa ke chunk berikutnya untuk menjaga konteks batas chunk.
RAG_CHUNK_OVERLAP_PARAGRAPHS="2"

# ------------------------------------------------------------------------------
# 6. Test RAG (opsional, hanya untuk test lokal/E2E)
# ------------------------------------------------------------------------------
# Base URL yang dipakai scripts/rag-smoke.ts.
RAG_TEST_BASE_URL="http://localhost:3000"

# Cookie session Better Auth lengkap, contoh: better-auth.session_token=...
# Jangan commit nilai asli.
RAG_TEST_SESSION_COOKIE=""

# Set ke 1 untuk mengaktifkan live database test di scripts/rag-db.test.ts.
RAG_DB_TEST="0"

# VERCEL_URL tidak perlu ditulis di sini; Vercel mengisinya otomatis.
